# Pinned sources of the My Daily Idea staging image (Phase F). build refuses when a remote ref no longer matches:
# a moved PR head or branch is a deliberate change here, never a silent fallback.
WRAPPER_REPO=https://github.com/scimbe/CADS-DEMO-wrapper.git
WRAPPER_MAIN=5d8e93859985d16d236ad799bb98b0cd3240f61b
# PR number:head commit, merged in this order (no-ff) onto main as local branch staging/mdi-w1 (order per W: #130->#137,
# #131->#132->#133->#136, #134, #138, #139). Stacked PRs contain their bases; their merge is then a no-op.
WRAPPER_PRS="130:b7a56c0779be7745536dc0ed345dd03ed9b811d6 137:1415b8bd65109d7b2dab21044aca720e309c3359 131:8865fae28b84840b4a27e55342f8047c6d5e9385 132:9b0f3aa6a34553c577bb3cc3db3ce89519c0a9ac 133:08d52fe9255076f894a8add58a60cfddc1edda4a 136:b74f221915e8b29ab3519a865680b5b4e049cb55 134:70b3a8ef3cf687bee143f9061af673ef431cdef3 138:4c5539f1aea316cdb60ad586623ef5523bc74275 139:84c4936cd4473ed92b70be4696003d7a3185af28"
APP_REPO=https://github.com/scimbe/CADS-agent-marketplace.git
APP_BRANCH=feat/mdi-paritaet
APP_COMMIT=96553b1149cb8a2fc6b34f3e669dd1073217ebb4
APP_DIR=apps/mdi
# Fixed author/committer date for the local merge and vendor commits: the same pins give the same staging/mdi-w1 SHA.
GIT_FIXED_DATE=2026-11-12T00:00:00Z
NODE_IMAGE=node:22-trixie
PW_IMAGE=mcr.microsoft.com/playwright:v1.56.1-noble
# Re-vendor the game kit (lib/vendor/mdi-baukasten) onto APP_COMMIT? 0 = keep the copy of wrapper #134 (vendored from app
# PR #264 6250fec with Security-Review M5). APP_COMMIT does not contain #264 yet: a re-vendor would roll back M5 (Strang B).
# Switch to 1 once #264 is in feat/mdi-paritaet and APP_COMMIT contains it.
VENDOR_BAUKASTEN=0
