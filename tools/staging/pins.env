# Pinned sources of the My Daily Idea staging image (Phase F). build refuses when a remote ref no longer matches:
# a moved PR head or branch is a deliberate change here, never a silent fallback.
WRAPPER_REPO=https://github.com/scimbe/CADS-DEMO-wrapper.git
WRAPPER_MAIN=5d8e93859985d16d236ad799bb98b0cd3240f61b
# PR number:head commit, merged in this order (no-ff) onto main as local branch staging/mdi-w1. Release set = W's checked
# order on origin/main (Integrator 2026-11-16): #130 #137 #131 #132 #133 #136 #135 #142 #134 #140 #141 #138 #139.
WRAPPER_PRS="130:b7a56c0779be7745536dc0ed345dd03ed9b811d6 137:1415b8bd65109d7b2dab21044aca720e309c3359 131:8865fae28b84840b4a27e55342f8047c6d5e9385 132:9b0f3aa6a34553c577bb3cc3db3ce89519c0a9ac 133:53c7768dfbf93e645da57d90225688bef1854801 136:a78a61a13626a463f4cb0ad2a23dc9ffc73f2b54 135:c5c9b7d881e566932b25d68e5612a4b3eaceb3a3 142:bf39aac876f3926fef285a84d6e2f0481aa2205a 134:62e3037e70d9db649559f07344ad9af2da2967b3 140:04e18ead80898c7e87709018fc7344bd2b4c3625 141:4f81825575343a00316be281f4fda03b5d7dea0f 138:b4952907e0a3bb2fafc971e3050be1fee290962a 139:84c4936cd4473ed92b70be4696003d7a3185af28"
APP_REPO=https://github.com/scimbe/CADS-agent-marketplace.git
APP_BRANCH=feat/mdi-paritaet
APP_COMMIT=bb78363dbccffe5574670cb717322dfd03146118
APP_DIR=apps/mdi
# Fixed author/committer date for the local merge and vendor commits: the same pins give the same staging/mdi-w1 SHA.
GIT_FIXED_DATE=2026-11-12T00:00:00Z
NODE_IMAGE=node:22-trixie
PW_IMAGE=mcr.microsoft.com/playwright:v1.56.1-noble
# Re-vendor the game kit (lib/vendor/mdi-baukasten) onto APP_COMMIT. Was 0 while APP_COMMIT lacked app PR #264 (M5, Strang B);
# #264 and #275 are in feat/mdi-paritaet since 51cc7e5f, APP_COMMIT contains them.
VENDOR_BAUKASTEN=1
