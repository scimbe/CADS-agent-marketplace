# Pinned sources of the My Daily Idea staging image (Phase F). build refuses when a remote ref no longer matches:
# a moved PR head or branch is a deliberate change here, never a silent fallback.
WRAPPER_REPO=https://github.com/scimbe/CADS-DEMO-wrapper.git
WRAPPER_MAIN=5d8e93859985d16d236ad799bb98b0cd3240f61b
# PR number:head commit, merged in this order (no-ff) onto main as local branch staging/mdi-w1. 133 is based on 132.
WRAPPER_PRS="130:b7a56c0779be7745536dc0ed345dd03ed9b811d6 131:ee69c01358db7ebad53d11425e53afad4e335669 132:b6eec8987815c8c6e9921bc0208b5b5ecfe22cdc 133:c7486f8808d0f61913690b4238d1159453310fc4 134:d1d44f85531a8f5b6b962549bdf38edf5e97ef51"
APP_REPO=https://github.com/scimbe/CADS-agent-marketplace.git
APP_BRANCH=feat/mdi-paritaet
APP_COMMIT=b30dcecf35f3731e68503bbc705583058da649fa
APP_DIR=apps/mdi
# Fixed author/committer date for the local merge and vendor commits: the same pins give the same staging/mdi-w1 SHA.
GIT_FIXED_DATE=2026-11-12T00:00:00Z
NODE_IMAGE=node:22-trixie
PW_IMAGE=mcr.microsoft.com/playwright:v1.56.1-noble
