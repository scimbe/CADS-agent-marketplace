{
  "id": "zug-kennst",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Kennst du mich wirklich?",
    "en": "Do you really know me?"
  },
  "teaser": {
    "de": "Fünf Fragen. Keine Ausrede.",
    "en": "Five questions. No excuses."
  },
  "howto": {
    "de": "Beantworte fünf Fragen über dich. Der andere rät deine Antworten und stellt dann seine. Wer mehr richtig hat, kennt den anderen besser.",
    "en": "Answer five questions about yourself. The other guesses your answers, then asks theirs. More right answers means you know each other better."
  },
  "rule": {
    "de": "Beantworte fünf Fragen über dich. Der andere rät deine Antworten und stellt dann seine. Wer mehr richtig hat, kennt den anderen besser.",
    "en": "Answer five questions about yourself. The other guesses your answers, then asks theirs. More right answers means you know each other better."
  },
  "seats": {
    "de": [
      "Spieler 1",
      "Spieler 2"
    ],
    "en": [
      "Player 1",
      "Player 2"
    ]
  },
  "roles": {
    "de": [
      "Du beantwortest fünf Fragen über dich und rätst später seine.",
      "Du rätst seine Antworten und stellst dann deine fünf."
    ],
    "en": [
      "You answer five questions about yourself and later guess theirs.",
      "You guess their answers, then answer your own five."
    ]
  },
  "grip": "abend",
  "dur": 60,
  "players": {
    "min": 2,
    "max": 2
  },
  "modes": [
    "alone",
    "link"
  ],
  "play": {
    "default": "link",
    "offer": [
      "link",
      "alone"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "inputs": {
    "type": "object",
    "required": [
      "t",
      "seat"
    ],
    "additionalProperties": false,
    "properties": {
      "t": {
        "enum": [
          "ans"
        ]
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "a": {},
      "d": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 100000
      }
    }
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
