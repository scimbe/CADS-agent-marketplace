{
  "id": "zug-hoeflich",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Bloß nicht frech werden",
    "en": "Do not get cheeky"
  },
  "teaser": {
    "de": "Streitet höflich, bis einer frech wird.",
    "en": "Argue politely until someone gets cheeky."
  },
  "howto": {
    "de": "Abwechselnd ein Satz, frecher bringt mehr Punkte auf den Pegel. Wer die geheime Grenze reißt, verliert.",
    "en": "Take turns with a line; cheekier adds more to the level. Whoever breaks the secret limit loses."
  },
  "rule": {
    "de": "Abwechselnd ein Satz, frecher bringt mehr Punkte auf den Pegel. Wer die geheime Grenze reißt, verliert.",
    "en": "Take turns with a line; cheekier adds more to the level. Whoever breaks the secret limit loses."
  },
  "seats": {
    "de": [
      "Spieler 1",
      "Spieler 2"
    ],
    "en": [
      "Player 1",
      "Player 2"
    ]
  },
  "roles": {
    "de": [
      "Du beginnst mit einem Satz.",
      "Du antwortest mit einem Satz."
    ],
    "en": [
      "You start with a line.",
      "You answer with a line."
    ]
  },
  "grip": "streit",
  "on": [
    "12-13"
  ],
  "dur": 40,
  "players": {
    "min": 2,
    "max": 2
  },
  "modes": [
    "alone",
    "link"
  ],
  "play": {
    "default": "link",
    "offer": [
      "link",
      "alone"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "inputs": {
    "type": "object",
    "required": [
      "t",
      "seat"
    ],
    "additionalProperties": false,
    "properties": {
      "t": {
        "enum": [
          "ans"
        ]
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "a": {},
      "d": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 100000
      }
    }
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
