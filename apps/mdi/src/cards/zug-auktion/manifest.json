        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "w": {
        "type": "string",
        "maxLength": 14,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
