    },
    {
      "id": "titel",
      "params": [
        "title",
        "w"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ],
  "variants": [
    {
      "id": "zug-deal",
      "title": {
        "de": "Zehn Kekse, ein Angebot",
        "en": "Ten cookies, one offer"
      },
      "teaser": {
        "de": "Teil fair, oder keiner kriegt was.",
        "en": "Split fairly or nobody gets any."
      },
      "rule": {
        "de": "Du teilst zehn: Wie viele gibst du ab? Der andere sagt, ab wie viel er annimmt. Darunter bekommt keiner etwas.",
        "en": "You split ten: how many do you give away? The other says from how many they accept. Below that nobody gets anything."
      },
      "params": {
        "spiel": "deal"
      }
    },
    {
      "id": "zug-teilen",
      "title": {
        "de": "Teilen ohne Streit",
        "en": "Share out without a fight"
      },
      "teaser": {
        "de": "Referat aufteilen, ohne Gemecker.",
        "en": "Split the project, no moaning."
      },
      "rule": {
        "de": "Verteil 10 Punkte auf die Aufgaben, die du am liebsten machst. Wer mehr setzt, bekommt die Aufgabe.",
        "en": "Spread 10 points over the tasks you like best. The higher bid gets the task."
      },
      "params": {
        "spiel": "teilen"
      }
    },
    {
      "id": "zug-socke",
      "title": {
        "de": "Letzte Socke unterm Hammer",
        "en": "Last sock under the hammer"
      },
      "teaser": {
        "de": "Bieten bis zur Dummheit.",
        "en": "Bid until it gets silly."
      },
      "rule": {
        "de": "Leg geheim fest, bis wie viel du für eine linke Socke mitbietest. Wer höher geht, bekommt sie.",
        "en": "Secretly set how far you bid for a left sock. Whoever goes higher gets it."
      },
      "params": {
        "spiel": "socke"
      }
    },
    {
      "id": "zug-fallpreis",
      "title": {
        "de": "Auktion um Quatsch",
        "en": "Auction of nonsense"
      },
      "teaser": {
        "de": "Der Preis fällt. Wer zuerst tippt, kauft.",
        "en": "The price drops. First tap buys."
      },
      "rule": {
        "de": "Der Preis fällt. Tipp, wenn er dir reicht. Wer mehr Gewinn macht, gewinnt.",
        "en": "The price drops. Tap when it is low enough. More profit wins."
      },
      "params": {
        "spiel": "fallpreis"
      }
    }
  ]
