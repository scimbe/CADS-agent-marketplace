{
  "id": "zug-auktion",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Auktion im Dunkeln",
    "en": "Auction in the dark"
  },
  "teaser": {
    "de": "100 Münzen, geheim bieten. Wer kriegt was?",
    "en": "100 coins, secret bids. Who gets what?"
  },
  "howto": {
    "de": "Verteil 100 Münzen auf fünf Dinge. Wer mehr bietet, bekommt es. Wer mehr Wert sammelt, gewinnt.",
    "en": "Spread 100 coins over five things. The higher bid gets it. Whoever collects more value wins."
  },
  "players": {
    "min": 2,
    "max": 2
  },
  "seats": {
    "de": [
      "Spieler 1",
      "Spieler 2"
    ],
    "en": [
      "Player 1",
      "Player 2"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "spiel",
      "title",
      "w",
      "accent"
    ],
    "properties": {
      "spiel": {
        "type": "string",
        "enum": [
          "auktion",
          "deal",
          "teilen",
          "socke",
          "fallpreis"
        ],
        "default": "auktion",
        "x-field": "choice",
        "x-label": {
          "de": "Spiel",
          "en": "Game"
        }
      },
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "w": {
        "type": "string",
        "maxLength": 14,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Was wird geteilt? (Zehn Kekse)",
          "en": "What is shared? (Ten cookies)"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "spiel",
      "params": [
        "spiel"
      ],
      "label": {
        "de": "Spiel",
        "en": "Game"
      }
    },
    {
      "id": "titel",
      "params": [
        "title",
        "w"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
