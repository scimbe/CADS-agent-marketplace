{
  "id": "raum-papagei",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Rückwärts- Papagei",
    "en": "Backwards parrot"
  },
  "teaser": {
    "de": "Sag es verkehrt. Hör, was rauskommt.",
    "en": "Say it backwards. Hear what comes out."
  },
  "howto": {
    "de": "Sprich ein Wort ins Handy. Der Nächste hört es rückwärts und spricht es nach. Dann wird geraten.",
    "en": "Say a word into the phone. The next person hears it backwards and copies it. Then everyone guesses."
  },
  "rule": {
    "de": "Sprich ein Wort ins Handy. Der Nächste hört es rückwärts und spricht es nach. Dann wird geraten.",
    "en": "Say a word into the phone. The next person hears it backwards and copies it. Then everyone guesses."
  },
  "seats": {
    "de": [
      "Runde"
    ],
    "en": [
      "Group"
    ]
  },
  "grip": "pause",
  "dur": 180,
  "players": {
    "min": 1,
    "max": 1
  },
  "modes": [
    "alone"
  ],
  "play": {
    "default": "alone",
    "offer": [
      "alone"
    ]
  },
  "hidden": "none",
  "uses": [
    "voice"
  ],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "inputs": {
    "type": "object",
    "required": [
      "t",
      "seat"
    ],
    "additionalProperties": false,
    "properties": {
      "t": {
        "enum": [
          "ans"
        ]
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 0
      },
      "a": {},
      "d": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 100000
      }
    }
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
