{
  "id": "mut-werbung",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Verkauf deinen Stift",
    "en": "Sell your pen"
  },
  "teaser": {
    "de": "Dreißig Sekunden Dauerwerbung.",
    "en": "Thirty seconds of pure ad."
  },
  "howto": {
    "de": "Drei Leute verkaufen je 30 Sekunden einen Stift. Dann wählt jeder, bei wem er kauft. Die meisten Stimmen gewinnen.",
    "en": "Three people each sell a pen for 30 seconds. Then each picks who to buy from. Most votes win."
  },
  "players": {
    "min": 1,
    "max": 1
  },
  "seats": {
    "de": [
      "Runde"
    ],
    "en": [
      "Group"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
