{
  "id": "raum-erklaeren",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "60 Sekunden Erklären",
    "en": "60 seconds to explain"
  },
  "teaser": {
    "de": "Reden, raten, Rekord knacken.",
    "en": "Talk, guess, beat the record."
  },
  "howto": {
    "de": "Erklär so viele Wörter wie möglich, ohne sie zu sagen. Ihr habt 60 Sekunden.",
    "en": "Explain as many words as you can without saying them. You have 60 seconds."
  },
  "players": {
    "min": 1,
    "max": 1
  },
  "seats": {
    "de": [
      "Runde"
    ],
    "en": [
      "Group"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
