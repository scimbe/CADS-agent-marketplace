{
  "id": "zug-wort",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Ein Wort für drei",
    "en": "One word for three"
  },
  "teaser": {
    "de": "Ein Hinweis, drei Wörter. Errät er sie?",
    "en": "One clue, three words. Can they guess?"
  },
  "howto": {
    "de": "Wähl drei von neun Wörtern und gib ein einziges Hinweiswort. Der andere tippt die drei Wörter. Jeder Treffer zählt.",
    "en": "Pick three of nine words and give one single clue word. The other taps the three words. Every hit counts."
  },
  "rule": {
    "de": "Wähl drei von neun Wörtern und gib ein einziges Hinweiswort. Der andere tippt die drei Wörter. Jeder Treffer zählt.",
    "en": "Pick three of nine words and give one single clue word. The other taps the three words. Every hit counts."
  },
  "seats": {
    "de": [
      "Spieler 1",
      "Spieler 2"
    ],
    "en": [
      "Player 1",
      "Player 2"
    ]
  },
  "roles": {
    "de": [
      "Du wählst drei Wörter und gibst ein Hinweiswort.",
      "Du tippst die drei Wörter, die gemeint sind."
    ],
    "en": [
      "You pick three words and give one clue.",
      "You tap the three words that are meant."
    ]
  },
  "grip": "pause",
  "on": [
    "12-17"
  ],
  "dur": 40,
  "players": {
    "min": 2,
    "max": 2
  },
  "modes": [
    "alone",
    "link"
  ],
  "play": {
    "default": "link",
    "offer": [
      "link",
      "alone"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "inputs": {
    "type": "object",
    "required": [
      "t",
      "seat"
    ],
    "additionalProperties": false,
    "properties": {
      "t": {
        "enum": [
          "ans"
        ]
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "a": {},
      "d": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 100000
      }
    }
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent",
      "ki",
      "fr"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      },
      "ki": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "k",
          "s",
          "h"
        ],
        "properties": {
          "k": {
            "type": "string",
            "const": "karte"
          },
          "s": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{8,200}$"
          },
          "h": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "o": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22}$"
          }
        },
        "default": null,
        "x-field": "text",
        "x-hidden": true,
        "x-label": {
          "de": "KI-Siegel",
          "en": "AI seal"
        }
      },
      "fr": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "default": null,
        "x-field": "text",
        "x-hidden": true,
        "x-label": {
          "de": "Freie Karte",
          "en": "Free card"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
