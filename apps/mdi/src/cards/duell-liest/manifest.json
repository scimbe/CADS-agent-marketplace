{
  "id": "duell-liest",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Dein Agent liest dich",
    "en": "Your agent reads you"
  },
  "teaser": {
    "de": "Zehn Runden. Er zählt mit.",
    "en": "Ten rounds. It keeps count."
  },
  "howto": {
    "de": "Stell deinen Agenten ein: Mut, Frechheit, Geduld. Er spielt allein gegen den Gegner. Danach forderst du jemanden heraus, dessen Agent gegen deinen antritt.",
    "en": "Set up your agent: courage, cheek, patience. It plays on its own against the rival. Then you challenge someone whose agent takes on yours."
  },
  "rule": {
    "de": "Dein Agent spielt nach seinen Reglern. Wer mehr Punkte holt, gewinnt.",
    "en": "Your agent plays by its sliders. More points wins."
  },
  "seats": {
    "de": [
      "Du",
      "Herausgefordert"
    ],
    "en": [
      "You",
      "Challenged"
    ]
  },
  "roles": {
    "de": [
      "Du stellst deinen Agenten ein und forderst heraus.",
      "Du stellst deinen Agenten gegen den des anderen."
    ],
    "en": [
      "You set up your agent and challenge someone.",
      "You set your agent against the other one."
    ]
  },
  "grip": "pause",
  "dur": 60,
  "players": {
    "min": 1,
    "max": 2
  },
  "modes": [
    "alone",
    "bot",
    "link"
  ],
  "play": {
    "default": "link",
    "offer": [
      "link",
      "alone",
      "bot"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 4096
  },
  "inputs": {
    "type": "object",
    "required": [
      "t",
      "seat"
    ],
    "additionalProperties": false,
    "properties": {
      "t": {
        "enum": [
          "agent",
          "hand",
          "ok",
          "again",
          "done"
        ]
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "a": {}
    }
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "m",
      "set",
      "w",
      "bn",
      "be",
      "br",
      "bc",
      "bp",
      "ar",
      "ac",
      "ap",
      "title",
      "accent"
    ],
    "properties": {
      "m": {
        "type": "string",
        "enum": [
          "rps",
          "mind",
          "rap",
          "auction",
          "deck"
        ],
        "default": "mind",
        "x-field": "choice",
        "x-label": {
          "de": "Arena",
          "en": "Arena"
        }
      },
      "set": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3,
        "default": 0,
        "x-field": "number",
        "x-label": {
          "de": "Deine drei Zeichen",
          "en": "Your three signs"
        }
      },
      "w": {
        "type": "string",
        "maxLength": 24,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Dein Wort (Rap, Auktion, Deck)",
          "en": "Your word (rap, auction, deck)"
        }
      },
      "bn": {
        "type": "string",
        "maxLength": 16,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "Dein Agent",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Name des Gegners",
          "en": "Rival name"
        }
      },
      "be": {
        "type": "string",
        "maxLength": 12,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "🧠",
        "x-field": "text",
        "x-label": {
          "de": "Aussehen des Gegners",
          "en": "Rival look"
        }
      },
      "br": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "x-field": "slide",
        "x-label": {
          "de": "Mut des Gegners",
          "en": "Rival courage"
        }
      },
      "bc": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "default": 75,
        "x-field": "slide",
        "x-label": {
          "de": "Frechheit des Gegners",
          "en": "Rival cheek"
        }
      },
      "bp": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "x-field": "slide",
        "x-label": {
          "de": "Geduld des Gegners",
          "en": "Rival patience"
        }
      },
      "ar": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "x-field": "slide",
        "x-label": {
          "de": "Mut deines Agenten (Start)",
          "en": "Your agent courage (start)"
        }
      },
      "ac": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "x-field": "slide",
        "x-label": {
          "de": "Frechheit deines Agenten (Start)",
          "en": "Your agent cheek (start)"
        }
      },
      "ap": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100,
        "default": 50,
        "x-field": "slide",
        "x-label": {
          "de": "Geduld deines Agenten (Start)",
          "en": "Your agent patience (start)"
        }
      },
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "ink",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "arena",
      "params": [
        "m",
        "set",
        "w"
      ],
      "label": {
        "de": "Arena",
        "en": "Arena"
      }
    },
