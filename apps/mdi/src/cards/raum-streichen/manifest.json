{
  "id": "raum-streichen",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Was machen wir jetzt?",
    "en": "What do we do now?"
  },
  "teaser": {
    "de": "Reihum streichen, bis eins bleibt.",
    "en": "Strike in turn until one is left."
  },
  "howto": {
    "de": "Sieben Vorschläge. Reihum streicht jeder einen. Was übrig bleibt, wird gemacht.",
    "en": "Seven suggestions. Take turns striking one. What is left is what you do."
  },
  "rule": {
    "de": "Sieben Vorschläge. Reihum streicht jeder einen. Was übrig bleibt, wird gemacht.",
    "en": "Seven suggestions. Take turns striking one. What is left is what you do."
  },
  "seats": {
    "de": [
      "Runde"
    ],
    "en": [
      "Group"
    ]
  },
  "grip": "raum",
  "dur": 40,
  "players": {
    "min": 1,
    "max": 1
  },
  "modes": [
    "alone"
  ],
  "play": {
    "default": "alone",
    "offer": [
      "alone"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "inputs": {
    "type": "object",
    "required": [
      "t",
      "seat"
    ],
    "additionalProperties": false,
    "properties": {
      "t": {
        "enum": [
          "ans"
        ]
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 0
      },
      "a": {},
      "d": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 100000
      }
    }
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
