{
  "id": "raum-maschine",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Einer von uns ist Maschine",
    "en": "One of us is a machine"
  },
  "teaser": {
    "de": "Drei Leute, eine falsche Reihe.",
    "en": "Three people, one fake row."
  },
  "howto": {
    "de": "Drei von euch beantworten sechs Fragen. Das Handy baut eine vierte Antwortreihe. Findet die Maschine.",
    "en": "Three of you answer six questions. The phone builds a fourth row of answers. Find the machine."
  },
  "players": {
    "min": 1,
    "max": 1
  },
  "seats": {
    "de": [
      "Runde"
    ],
    "en": [
      "Group"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
