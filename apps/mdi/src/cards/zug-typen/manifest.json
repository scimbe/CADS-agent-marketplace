{
  "id": "zug-typen",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Wer von uns ist …?",
    "en": "Which of us is …?"
  },
  "teaser": {
    "de": "Gruppenquiz: jede Person findet ihre Stärke.",
    "en": "Group quiz: everyone finds their strength."
  },
  "howto": {
    "de": "Gruppenquiz: jede Person findet ihre Stärke.",
    "en": "Group quiz: everyone finds their strength."
  },
  "grip": "abend",
  "dur": 60,
  "players": {
    "min": 2,
    "max": 2
  },
  "seats": {
    "de": [
      "Spieler 1",
      "Spieler 2"
    ],
    "en": [
      "Player 1",
      "Player 2"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 20,
    "stateBytes": 8192
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "paket",
      "pk"
    ],
    "properties": {
      "paket": {
        "type": "string",
        "enum": [
          "",
          "klassenfahrt",
          "teamtyp"
        ],
        "default": "klassenfahrt",
        "x-field": "choice",
        "x-label": {
          "de": "Fertiges Paket",
          "en": "Ready pack"
        }
      },
      "pk": {
        "type": [
          "object",
          "null"
        ],
        "default": null,
        "x-field": "list",
        "x-label": {
          "de": "Eigenes Fragenpaket",
          "en": "Own question pack"
        },
        "additionalProperties": false,
        "required": [
          "t",
          "m",
          "q"
        ],
        "properties": {
          "t": {
            "type": "string",
            "maxLength": 200
          },
          "m": {
            "type": "string",
            "enum": [
              "l",
              "f",
              "g"
            ]
          },
          "q": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "array",
              "maxItems": 6
            }
          },
          "z": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "integer"
            }
          },
          "y": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "array",
              "maxItems": 2
            }
          },
          "u": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          }
        }
      }
    }
  },
  "parts": [
    {
      "id": "paket",
      "params": [
        "paket",
        "pk"
      ],
      "label": {
        "de": "Fragenpaket",
        "en": "Question pack"
      }
    }
  ],
  "modes": [
    "alone",
    "link",
    "live"
  ],
  "play": {
    "default": "link",
    "offer": [
      "link",
      "alone"
    ]
  },
  "inputs": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "t",
      "seat",
      "a"
    ],
    "properties": {
      "t": {
        "const": "ans"
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "a": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000000
          },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            }
          },
          {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string",
              "maxLength": 28
            }
          }
        ]
      },
      "d": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
      }
    }
  }
}
