{
  "id": "karte-regel",
  "version": "1.0.0",
  "sdk": "mdi-sdk/0.1",
  "kind": "turn",
  "mode": "turn",
  "title": {
    "de": "Neue Regel für alle",
    "en": "New rule for everyone"
  },
  "teaser": {
    "de": "Jeder tauscht genau ein Wort.",
    "en": "Everyone swaps one word."
  },
  "howto": {
    "de": "Ein Satz für alle. Abwechselnd tauscht ihr ein Wort aus. Nach fünf Zügen gilt das Gesetz.",
    "en": "One rule for everyone. Take turns swapping one word. After five moves the law stands."
  },
  "rule": {
    "de": "Ein Satz für alle. Abwechselnd tauscht ihr ein Wort aus. Nach fünf Zügen gilt das Gesetz.",
    "en": "One rule for everyone. Take turns swapping one word. After five moves the law stands."
  },
  "seats": {
    "de": [
      "Spieler 1",
      "Spieler 2"
    ],
    "en": [
      "Player 1",
      "Player 2"
    ]
  },
  "roles": {
    "de": [
      "Du tauschst ein Wort.",
      "Du tauschst das nächste Wort."
    ],
    "en": [
      "You swap one word.",
      "You swap the next word."
    ]
  },
  "grip": "abend",
  "dur": 30,
  "players": {
    "min": 2,
    "max": 2
  },
  "modes": [
    "alone",
    "link"
  ],
  "play": {
    "default": "link",
    "offer": [
      "link",
      "alone"
    ]
  },
  "hidden": "none",
  "uses": [],
  "limits": {
    "stepBudget": 64,
    "stateBytes": 8192
  },
  "inputs": {
    "type": "object",
    "required": [
      "t",
      "seat"
    ],
    "additionalProperties": false,
    "properties": {
      "t": {
        "enum": [
          "ans"
        ]
      },
      "seat": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1
      },
      "a": {},
      "d": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 100000
      }
    }
  },
  "params": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "accent",
      "ki",
      "fr"
    ],
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 40,
        "pattern": "^[^\\u0000-\\u001f\\u007f<>]*$",
        "default": "",
        "x-field": "text",
        "x-model": true,
        "x-label": {
          "de": "Titel",
          "en": "Title"
        }
      },
      "accent": {
        "type": "string",
        "enum": [
          "yellow",
          "red",
          "ink",
          "paper"
        ],
        "default": "yellow",
        "x-field": "color",
        "x-label": {
          "de": "Kartenfarbe",
          "en": "Card colour"
        }
      },
      "ki": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "k",
          "s",
          "h"
        ],
        "properties": {
          "k": {
            "type": "string",
            "const": "karte"
          },
          "s": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{8,200}$"
          },
          "h": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "o": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{22}$"
          }
        },
        "default": null,
        "x-field": "text",
        "x-hidden": true,
        "x-label": {
          "de": "KI-Siegel",
          "en": "AI seal"
        }
      },
      "fr": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[A-Za-z0-9_-]{22}$",
        "default": null,
        "x-field": "text",
        "x-hidden": true,
        "x-label": {
          "de": "Freie Karte",
          "en": "Free card"
        }
      }
    }
  },
  "parts": [
    {
      "id": "titel",
      "params": [
        "title"
      ],
      "label": {
        "de": "Titel",
        "en": "Title"
      }
    },
    {
      "id": "farbe",
      "params": [
        "accent"
      ],
      "label": {
        "de": "Kartenfarbe",
        "en": "Card colour"
      }
    }
  ]
}
