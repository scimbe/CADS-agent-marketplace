{
  "$id": "link",
  "$defs": {
    "cardId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "params": {
      "type": "object",
      "maxProperties": 48
    },
    "commit": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "input": {
      "type": "object",
      "required": [
        "t",
        "seat"
      ],
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-]{1,24}$"
      },
      "properties": {
        "t": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,15}$"
        },
        "seat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "additionalProperties": {
        "$ref": "link#/$defs/value"
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c",
        "v",
        "p"
      ],
      "properties": {
        "c": {
          "$ref": "link#/$defs/cardId"
        },
        "v": {
          "$ref": "link#/$defs/version"
        },
        "p": {
          "$ref": "link#/$defs/params"
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c",
        "v",
        "p",
        "s",
        "k",
        "m",
        "g"
      ],
      "properties": {
        "c": {
          "$ref": "link#/$defs/cardId"
        },
        "v": {
          "$ref": "link#/$defs/version"
        },
        "p": {
          "$ref": "link#/$defs/params"
        },
        "s": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "k": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "link#/$defs/commit"
          }
        },
        "m": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "link#/$defs/input"
          }
        },
        "g": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "h": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      }
    },
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        }
      }
    },
    "text": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f<>]*$"
    },
    "value": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 4294967295
        },
        {
          "$ref": "link#/$defs/text"
        },
        {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "link#/$defs/value"
          }
        },
        {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,24}$"
          },
          "additionalProperties": {
            "$ref": "link#/$defs/value"
          }
        }
      ]
    },
    "ghost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "c",
        "v",
        "p",
        "s",
        "tr",
        "n",
        "sc",
        "h"
      ],
      "properties": {
        "c": {
          "$ref": "link#/$defs/cardId"
        },
        "v": {
          "$ref": "link#/$defs/version"
        },
        "p": {
          "$ref": "link#/$defs/params"
        },
        "s": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "tr": {
          "type": "string",
          "maxLength": 3200,
          "pattern": "^[A-Za-z0-9_-]*$"
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 216000
        },
        "sc": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "h": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "g": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "q": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "lv": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "rl": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "enum": [
              "human",
              "bot",
              "none",
              "ghost"
            ]
          }
        }
      }
    }
  }
}
