  "description": "My Daily Idea, Neuentwurf (Slice D0): Statechart, Kartenvertrag mit verdeckter Information, ein Renderer",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
