<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ report_title }}</title>
<style>
  body { font-family: "Helvetica Neue", Arial, sans-serif; color: #222; margin: 0; padding: 0 32px 48px; background: #fff; }
  header { border-bottom: 3px solid #1f4e79; padding: 28px 0 16px; margin-bottom: 24px; }
  header h1 { margin: 0 0 4px; font-size: 26px; color: #1f4e79; }
  header .meta { color: #666; font-size: 13px; }
  h2 { font-size: 17px; color: #1f4e79; border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 32px; }
  .highlights { display: flex; flex-wrap: wrap; gap: 12px; margin: 16px 0; }
  .card { flex: 1 1 150px; background: #f4f7fa; border: 1px solid #dde5ec; border-radius: 6px; padding: 12px 14px; }
  .card .label { font-size: 12px; color: #667; text-transform: uppercase; letter-spacing: 0.03em; }
  .card .value { font-size: 22px; font-weight: 600; color: #1f4e79; margin-top: 2px; }
  .card .date { font-size: 11px; color: #888; margin-top: 2px; }
  .narrative { font-size: 15px; line-height: 1.6; background: #fffbe8; border-left: 4px solid #e8b400; padding: 12px 16px; margin: 16px 0; }
  table { border-collapse: collapse; width: 100%; margin: 12px 0 24px; font-size: 13px; }
  th, td { border: 1px solid #dde5ec; padding: 6px 10px; text-align: right; }
  th { background: #1f4e79; color: #fff; text-align: right; }
  td:first-child, th:first-child { text-align: left; }
  .chart { margin: 16px 0; text-align: center; }
  .chart img { max-width: 100%; }
  footer { margin-top: 40px; padding-top: 12px; border-top: 1px solid #ddd; font-size: 11px; color: #888; }
  code { background: #f4f4f4; padding: 1px 4px; border-radius: 3px; }
</style>
</head>
<body>
<header>
  <h1>{{ report_title }}</h1>
  <div class="meta">{{ facts.location }} &middot; generated {{ facts.generated_at }} &middot; source: <a href="{{ facts.source_url }}">Open-Meteo API</a></div>
</header>

<h2>This Week at a Glance</h2>
<div class="highlights">
  {% for h in selected_highlights %}
  <div class="card">
    <div class="label">{{ h.label }}</div>
    <div class="value">{{ h.value }}{{ h.unit }}</div>
    {% if h.date %}<div class="date">{{ h.date }}</div>{% endif %}
  </div>
  {% endfor %}
</div>

<h2>Briefing</h2>
<div class="narrative">{{ narrative }}</div>

<h2>Temperature</h2>
<div class="chart"><img src="{{ chart_temperature_path }}" alt="Temperature chart"></div>

<h2>Precipitation</h2>
<div class="chart"><img src="{{ chart_precipitation_path }}" alt="Precipitation chart"></div>

<h2>Daily Data</h2>
<table>
  <thead>
    <tr><th>Date</th><th>High (°C)</th><th>Low (°C)</th><th>Precip (mm)</th><th>Wind max (km/h)</th></tr>
  </thead>
  <tbody>
    {% for d in facts.days %}
    <tr><td>{{ d.date }}</td><td>{{ d.tmax }}</td><td>{{ d.tmin }}</td><td>{{ d.precip_mm }}</td><td>{{ d.wind_max_kmh }}</td></tr>
    {% endfor %}
  </tbody>
</table>

<footer>
  Generated by CADS-DEMO-newsletter. Every figure above comes directly from the Open-Meteo forecast API
  response (<code>{{ facts.source_url }}</code>); the narrative text above was written by
  <code>{{ model_name }}</code> selecting and phrasing these figures under an enforced facts-only guard
  {% if llm_fallback_used %}&mdash; note: the LLM output failed the guard on this run, so the narrative
  above is the deterministic fallback sentence, not model-written prose{% endif %}.
  This is a demo artifact; forecast data is not archived and will differ on each regeneration.
</footer>
</body>
</html>
