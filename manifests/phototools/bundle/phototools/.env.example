# litellm-proxy connection for the optional `--summary` step (src/llm/summarize.js).
# The deterministic organize/watermark/contact-sheet pipeline never reads these -- it works
# with none of this set. Only `phototools organize --summary` touches the network.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-changeme
LITELLM_DEFAULT_MODEL=local-devstral-small2
